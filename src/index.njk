---
layout: layouts/base.njk
---
<main>
<section aria-labelledby="hero-title">
<div class="container hero">
<p class="prompt">daniel@home ~ % whoami</p>
<h1 id="hero-title">{{ site.name }}</h1>
<p class="lede">Frontend developer with 11+ years building secure, scalable web and mobile apps for the financial sector. React, Next.js and TypeScript by trade, Node.js on the backend.</p>
<p class="meta-row">
<span class="status">Open to full-stack roles</span>
<span>Cuernavaca, MX · UTC−6</span>
<span>ES / EN</span>
</p>
<div class="actions">
<a class="btn btn--primary" target="_blank" rel="noopener noreferrer" href="{{ site.cvUrl }}">Download CV</a>
<a class="btn" href="{{ site.github }}">GitHub ↗</a>
<a class="btn" href="{{ site.linkedin }}">LinkedIn ↗</a>
</div>
</div>
</section>

<section id="work" class="section" aria-labelledby="work-title">
<div class="container section__inner">
<h2 id="work-title" class="section-label">/work</h2>
<div class="section-body work">
{% for job in work %}
<div class="row-between">
<div class="company">
<h3>{{ job.company }}</h3>
<p>{{ job.role }}</p>
</div>
<p class="dates">{{ job.dates }}</p>
</div>
{% for project in job.projects %}
<article class="project">
<div class="row-between">
<h4>{{ project.title }}</h4>
<span class="badge{% if project.active %} badge--solid{% endif %}">{{ project.status }}</span>
</div>
<p>{{ project.summary }}</p>
{% if project.stats %}
<dl class="stats">
{% for stat in project.stats %}
<div>
<dt>{{ stat.label }}</dt>
<dd>{{ stat.value }}</dd>
</div>
{% endfor %}
</dl>
{% endif %}
</article>
{% endfor %}
{% endfor %}
</div>
</div>
</section>

<section id="stack" class="section" aria-labelledby="stack-title">
<div class="container section__inner">
<h2 id="stack-title" class="section-label">/stack</h2>
<div class="section-body code-window code-window--stack">
<div class="code-window__bar">
<span>{{ stack.filename }}</span>
<span>{{ stack.rows | length }} keys</span>
</div>
<div class="code-window__scroll">
<pre><code>
{%- for row in stack.rows -%}
<span class="muted">{{ loop.index | padEnd(3) }}</span>{{ row.key | padEnd(stack.keyWidth) }} = [{% for value in row.values %}<span>"{{ value }}"</span>{% if not loop.last %}, {% endif %}{% endfor %}]{% if row.comment %}  <span class="muted"># {{ row.comment }}</span>{% endif %}{% if not loop.last %}
{% endif %}
{%- endfor -%}
</code></pre>
</div>
</div>
</div>
</section>

<section id="writing" class="section" aria-labelledby="writing-title">
<div class="container section__inner">
<h2 id="writing-title" class="section-label">/writing</h2>
<div class="section-body">
{% for post in collections.posts | newestFirst | take(3) %}
<a class="post-row" href="{{ post.url }}">
<span class="post-row__date">{% if post.data.draft %}draft{% else %}{{ post.date | isoDate }}{% endif %}</span>
<span class="post-row__title">{{ post.data.title }}</span>
<span class="post-row__arrow" aria-hidden="true">→</span>
</a>
{% else %}
<p class="muted">Nothing published yet.</p>
{% endfor %}
<a class="text-link" href="/writing/">All posts</a>
</div>
</div>
</section>

<section id="about" class="section" aria-labelledby="about-title">
<div class="container section__inner">
<h2 id="about-title" class="section-label">/about</h2>
<div class="section-body about">
<p class="about__intro">I'm a frontend developer based in Cuernavaca, Mexico. Since 2015 I've built software for the financial sector, where reliability and security come first. I use AI coding tools every day for planning, building and testing.</p>
<dl class="facts">
<div>
<dt>education</dt>
<dd>B.Eng. in Computer Technologies<br><span class="muted">Tecnológico de Monterrey, Campus Cuernavaca · 2012</span></dd>
</div>
<div>
<dt>languages</dt>
<dd>Spanish, native<br><span class="muted">English, upper-intermediate</span></dd>
</div>
</dl>
</div>
</div>
</section>

<section id="contact" class="section section--last" aria-labelledby="contact-title">
<div class="container section__inner">
<h2 id="contact-title" class="section-label">/contact</h2>
<div class="section-body contact">
<p class="contact__lede">Hiring for a frontend or full-stack role? Write to me.</p>
<div class="contact__row">
<p class="contact__email"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
<button type="button" class="pill-btn pill-btn--wide js-only" data-copy="{{ site.email }}"><span data-copy-label aria-live="polite">Copy</span></button>
</div>
</div>
</div>
</section>
</main>
