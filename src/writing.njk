---
layout: layouts/base.njk
title: Writing
permalink: /writing/
---
<main>
<div class="container page-intro">
<p class="prompt">~/writing % ls -t</p>
<h1>Writing</h1>
<p class="page-intro__lede">{{ site.writingIntro }}</p>
</div>

<div class="container archive">
{% for group in collections.posts | groupByYear %}
<section class="year" aria-labelledby="y{{ group.year }}">
<h2 id="y{{ group.year }}" class="section-label year__label">{{ group.year }}</h2>
<div class="year__posts">
{% for post in group.posts %}
<a class="post-card" href="{{ post.url }}">
<span class="post-card__head">
<span class="post-card__title">{{ post.data.title }}</span>
<span class="post-card__meta">{% if post.data.draft %}draft{% else %}{{ post.date | monthDay }}{% endif %} · {{ post.content | readingTime }} min</span>
</span>
{% if post.data.description %}<span class="post-card__summary">{{ post.data.description }}</span>{% endif %}
{% if post.data.tags %}
<span class="tags">
{% for tag in post.data.tags %}<span class="tag">#{{ tag }}</span>{% endfor %}
</span>
{% endif %}
</a>
{% endfor %}
</div>
</section>
{% else %}
<p class="muted">Nothing published yet.</p>
{% endfor %}

<p class="feed-link"><a href="/rss.xml">rss.xml</a></p>
</div>
</main>
